<?php
/**
 * Dispatched by the `*` route. Expects $title; $code and $message are optional.
 *
 * A 404 on a documentation site means someone followed a link to a page that moved, so this one
 * carries search and the three places worth trying — it is the one status page that can actually
 * help you get where you were going.
 */
$code       = $code ?? 404;
$heading    = ($code === 404) ? 'That page is not here' : (string)$title;
$showSearch = ($code === 404);

$body = ($code === 404)
    ? 'The page you asked for does not exist, or it moved when the v7 documentation was '
      . 'reorganized. Search below, or start from one of these.'
    : 'Something went wrong handling that request.';

$actions = ($code === 404) ? [
    ['href' => '/',                                 'label' => 'Overview'],
    ['href' => '/getting-started/installation',     'label' => 'Getting Started'],
    ['href' => '/components',                       'label' => 'All Components'],
] : [];

include __DIR__ . '/partials/status.phtml';

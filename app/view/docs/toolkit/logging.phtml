<pre><code><span class="text-kw">use </span><span class="text-var">Pop\Log\Formatter</span><span class="text-kw">;
use </span><span class="text-var">Pop\Log\Logger</span><span class="text-kw">;
use </span><span class="text-var">Pop\Log\Writer\File</span><span class="text-kw">;

</span><span class="text-var">$log </span><span class="text-kw">= new </span><span class="text-var">Logger</span><span class="text-kw">(new </span><span class="text-var">File</span><span class="text-kw">(</span><span class="text-var">__DIR__ </span><span class="text-kw">. </span><span class="text-str">&#039;/../logs/app.log&#039;</span><span class="text-kw">, new </span><span class="text-var">Formatter\NdJson</span><span class="text-kw">()));

</span><span class="text-var">$log</span><span class="text-kw">-&gt;</span><span class="text-var">warning</span><span class="text-kw">(</span><span class="text-str">&#039;Disk nearly full&#039;</span><span class="text-kw">, [</span><span class="text-str">&#039;free&#039; </span><span class="text-kw">=&gt; </span><span class="text-str">&#039;2%&#039;</span><span class="text-kw">]);
</span></code></pre>
</div>

<p>which writes one JSON object per line:</p>
<div class="code-window" x-data="copyCode">
<div class="code-window-bar"><span class="code-lang">JSON</span><button type="button" class="code-copy" @click="copy()" :aria-label="copied ? 'Copied' : 'Copy code'" aria-label="Copy code"><svg x-show="!copied" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11.5" height="11.5" rx="2.4"></rect><path d="M15 5.6A2.6 2.6 0 0 0 12.4 3H5.6A2.6 2.6 0 0 0 3 5.6v6.8A2.6 2.6 0 0 0 5.6 15"></path></svg><svg x-show="copied" x-cloak class="code-copied" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5 9 17l10.5-10.5"></path></svg></button></div>

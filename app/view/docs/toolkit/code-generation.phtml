<pre><code><span class="text-kw">use</span> <span class="text-type">Pop\Code\Generator</span>;

<span class="text-var">$interface</span> = <span class="text-kw">new</span> <span class="text-type">Generator\InterfaceGenerator</span>(<span class="text-str">&#039;Arrayable&#039;</span>);
<span class="text-var">$interface</span>-&gt;<span class="text-fn">addMethod</span>((<span class="text-kw">new</span> <span class="text-type">Generator\MethodGenerator</span>(<span class="text-str">&#039;toArray&#039;</span>))-&gt;<span class="text-fn">addReturnType</span>(<span class="text-str">&#039;array&#039;</span>));

<span class="text-kw">echo</span> <span class="text-var">$interface</span>;

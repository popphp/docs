</span><span class="text-var">Arr</span><span class="text-kw">::</span><span class="text-var">split</span><span class="text-kw">(</span><span class="text-str">&#039;a,b,c&#039;</span><span class="text-kw">, </span><span class="text-str">&#039;,&#039;</span><span class="text-kw">);               </span><span class="text-comment">// [&#039;a&#039;, &#039;b&#039;, &#039;c&#039;]
</span></code></pre>

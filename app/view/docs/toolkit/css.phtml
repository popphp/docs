<p>Media queries are their own object, holding their own selectors, added to the stylesheet alongside the
top-level ones:</p>
<div class="code-window" x-data="copyCode">
<div class="code-window-bar"><span class="code-lang">PHP</span><button type="button" class="code-copy" @click="copy()" :aria-label="copied ? 'Copied' : 'Copy code'" aria-label="Copy code"><svg x-show="!copied" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11.5" height="11.5" rx="2.4"></rect><path d="M15 5.6A2.6 2.6 0 0 0 12.4 3H5.6A2.6 2.6 0 0 0 3 5.6v6.8A2.6 2.6 0 0 0 5.6 15"></path></svg><svg x-show="copied" x-cloak class="code-copied" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5 9 17l10.5-10.5"></path></svg></button></div>
<pre><code><span class="text-kw">use</span> <span class="text-type">Pop\Css\Css</span>;
<span class="text-kw">use</span> <span class="text-type">Pop\Css\Media</span>;
<span class="text-kw">use</span> <span class="text-type">Pop\Css\Selector</span>;

<span class="text-var">$login</span> = <span class="text-kw">new</span> <span class="text-type">Selector</span>(<span class="text-str">&#039;#login&#039;</span>);
<span class="text-var">$login</span>-&gt;<span class="text-fn">setProperty</span>(<span class="text-str">&#039;width&#039;</span>, <span class="text-str">&#039;50%&#039;</span>);

<span class="text-var">$media</span> = <span class="text-kw">new</span> <span class="text-type">Media</span>(<span class="text-str">&#039;screen&#039;</span>);
<span class="text-var">$media</span>-&gt;<span class="text-fn">setFeature</span>(<span class="text-str">&#039;max-width&#039;</span>, <span class="text-str">&#039;480px&#039;</span>);
<span class="text-var">$media</span>[<span class="text-str">&#039;#login&#039;</span>] = <span class="text-kw">new</span> <span class="text-type">Selector</span>();
<span class="text-var">$media</span>[<span class="text-str">&#039;#login&#039;</span>]-&gt;<span class="text-fn">setProperty</span>(<span class="text-str">&#039;width&#039;</span>, <span class="text-str">&#039;75%&#039;</span>);

<span class="text-kw">echo</span> (<span class="text-kw">new</span> <span class="text-type">Css</span>())-&gt;<span class="text-fn">addSelector</span>(<span class="text-var">$login</span>)-&gt;<span class="text-fn">addMedia</span>(<span class="text-var">$media</span>);
</code></pre>

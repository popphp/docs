    protected array   </span><span class="text-var">$jsonFields    </span><span class="text-kw">= [</span><span class="text-str">&#039;preferences&#039;</span><span class="text-kw">];
    protected </span><span class="text-var">string  $hashAlgorithm </span><span class="text-kw">= </span><span class="text-var">PASSWORD_BCRYPT</span><span class="text-kw">;
    protected array   </span><span class="text-var">$hashOptions   </span><span class="text-kw">= [</span><span class="text-str">&#039;cost&#039; </span><span class="text-kw">=&gt; </span><span class="text-var">12</span><span class="text-kw">];


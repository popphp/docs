        <span class="text-str">&#039;adapter&#039;</span>  =&gt; <span class="text-var">$_ENV</span>[<span class="text-str">&#039;DB_ADAPTER&#039;</span>],
        <span class="text-str">&#039;username&#039;</span> =&gt; <span class="text-var">$_ENV</span>[<span class="text-str">&#039;DB_USERNAME&#039;</span>],
        <span class="text-str">&#039;password&#039;</span> =&gt; <span class="text-var">$_ENV</span>[<span class="text-str">&#039;DB_PASSWORD&#039;</span>],

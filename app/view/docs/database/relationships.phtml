<pre><code><span class="text-kw">&lt;?php
</span>
<span class="text-kw">namespace</span> <span class="text-type">App\Table</span>;

<span class="text-kw">use</span> <span class="text-type">Pop\Db\Record</span>;

<span class="text-kw">class</span> <span class="text-type">Profiles</span> <span class="text-kw">extends</span> <span class="text-type">Record</span>
{

    <span class="text-kw">protected</span> <span class="text-kw">array</span> <span class="text-var">$primaryKeys</span> = [<span class="text-str">&#039;author_id&#039;</span>];

    <span class="text-kw">public</span> <span class="text-kw">function</span> <span class="text-fn">author</span>(?<span class="text-kw">array</span> <span class="text-var">$options</span> = <span class="text-num">null</span>, <span class="text-type">bool</span> <span class="text-var">$eager</span> = <span class="text-num">false</span>)
    {
        <span class="text-kw">return</span> <span class="text-var">$this</span>-&gt;<span class="text-fn">belongsTo</span>(<span class="text-str">&#039;App\Table\Authors&#039;</span>, <span class="text-str">&#039;author_id&#039;</span>, <span class="text-var">$options</span>, <span class="text-var">$eager</span>);
    }

}

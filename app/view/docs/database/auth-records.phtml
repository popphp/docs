<span class="text-kw">use</span> <span class="text-type">Pop\Db\Record\Auth</span>;

<span class="text-kw">class</span> <span class="text-type">Users</span> <span class="text-kw">extends</span> <span class="text-type">Auth</span>
{

    <span class="text-kw">protected</span> <span class="text-kw">array</span> <span class="text-var">$jsonFields</span>  = [<span class="text-str">&#039;preferences&#039;</span>];
    <span class="text-kw">protected</span> <span class="text-kw">array</span> <span class="text-var">$hashOptions</span> = [<span class="text-str">&#039;cost&#039;</span> =&gt; <span class="text-num">12</span>];

}

<pre><code><span class="text-kw">use </span><span class="text-var">Pop\Db\Record</span><span class="text-kw">;

</span><span class="text-var">$db </span><span class="text-kw">= </span><span class="text-var">Record</span><span class="text-kw">::</span><span class="text-var">getDb</span><span class="text-kw">();

</span><span class="text-var">$sql    </span><span class="text-kw">= </span><span class="text-var">$db</span><span class="text-kw">-&gt;</span><span class="text-var">createSql</span><span class="text-kw">();
</span><span class="text-var">$select </span><span class="text-kw">= </span><span class="text-var">$sql</span><span class="text-kw">-&gt;</span><span class="text-var">select</span><span class="text-kw">([</span><span class="text-str">&#039;id&#039;</span><span class="text-kw">, </span><span class="text-str">&#039;username&#039;</span><span class="text-kw">])-&gt;</span><span class="text-var">from</span><span class="text-kw">(</span><span class="text-str">&#039;users&#039;</span><span class="text-kw">)-&gt;</span><span class="text-var">where</span><span class="text-kw">(</span><span class="text-str">&#039;id = :id&#039;</span><span class="text-kw">);

echo </span><span class="text-var">$select</span><span class="text-kw">;                            </span><span class="text-comment">// safe to read
</span><span class="text-kw">echo </span><span class="text-var">$select</span><span class="text-kw">;                            </span><span class="text-comment">// and to read again

</span><span class="text-var">$users </span><span class="text-kw">= </span><span class="text-var">$db</span><span class="text-kw">-&gt;</span><span class="text-var">select</span><span class="text-kw">(</span><span class="text-var">$sql</span><span class="text-kw">, [</span><span class="text-str">&#039;id&#039; </span><span class="text-kw">=&gt; </span><span class="text-var">1</span><span class="text-kw">]); </span><span class="text-comment">// still runnable

<pre><code><span class="text-var">&lt;?php

</span><span class="text-kw">namespace </span><span class="text-var">App\Http\Controller</span><span class="text-kw">;

use </span><span class="text-var">Pop\Controller\AbstractController</span><span class="text-kw">;

class </span><span class="text-var">StatusController </span><span class="text-kw">extends </span><span class="text-var">AbstractController
</span><span class="text-kw">{

    public function </span><span class="text-var">index</span><span class="text-kw">(): </span><span class="text-var">void
    </span><span class="text-kw">{
        echo </span><span class="text-str">&#039;OK&#039;</span><span class="text-kw">;
    }

}
</span></code></pre>
</div>

<div class="code-window" x-data="copyCode">
<div class="code-window-bar"><span class="code-lang">PHP</span><span class="code-file">app/config/app.http.php</span><button type="button" class="code-copy" @click="copy()" :aria-label="copied ? 'Copied' : 'Copy code'" aria-label="Copy code"><svg x-show="!copied" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11.5" height="11.5" rx="2.4"></rect><path d="M15 5.6A2.6 2.6 0 0 0 12.4 3H5.6A2.6 2.6 0 0 0 3 5.6v6.8A2.6 2.6 0 0 0 5.6 15"></path></svg><svg x-show="copied" x-cloak class="code-copied" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5 9 17l10.5-10.5"></path></svg></button></div>
<pre><code><span class="text-var">&lt;?php
</span><span class="text-kw">return [
    </span><span class="text-str">&#039;routes&#039; </span><span class="text-kw">=&gt; [
        </span><span class="text-str">&#039;/status&#039; </span><span class="text-kw">=&gt; [
            </span><span class="text-str">&#039;controller&#039; </span><span class="text-kw">=&gt; </span><span class="text-str">&#039;App\Http\Controller\StatusController&#039;</span><span class="text-kw">,
            </span><span class="text-str">&#039;action&#039;     </span><span class="text-kw">=&gt; </span><span class="text-str">&#039;index&#039;
        </span><span class="text-kw">]
    ]
];
</span></code></pre>

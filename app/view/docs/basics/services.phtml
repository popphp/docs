    <span class="text-str">&#039;params&#039;</span> =&gt; [<span class="text-str">&#039;dir&#039;</span> =&gt; <span class="text-kw">__DIR__</span> . <span class="text-str">&#039;/uploads&#039;</span>, <span class="text-str">&#039;maxSize&#039;</span> =&gt; <span class="text-num">1000000</span>]
]);

<span class="text-kw">echo</span> <span class="text-fn">get_class</span>(<span class="text-var">$app</span>-&gt;<span class="text-fn">getService</span>(<span class="text-str">&#039;session&#039;</span>));   <span class="text-comment">// Pop\Session\Session</span>
</code></pre>

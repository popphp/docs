<pre><code><span class="text-var">$app</span> = <span class="text-kw">new</span> <span class="text-type">Pop\Application</span>();

<span class="text-var">$app</span>-&gt;<span class="text-fn">setService</span>(<span class="text-str">&#039;session&#039;</span>, [<span class="text-str">&#039;call&#039;</span> =&gt; <span class="text-str">&#039;Pop\Session\Session::getInstance&#039;</span>]);
<span class="text-var">$app</span>-&gt;<span class="text-fn">setService</span>(<span class="text-str">&#039;cookie&#039;</span>, <span class="text-str">&#039;Pop\Cookie\Cookie::getInstance&#039;</span>);
<span class="text-var">$app</span>-&gt;<span class="text-fn">setService</span>(<span class="text-str">&#039;uploads&#039;</span>, [

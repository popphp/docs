<pre><code>#!/usr/bin/env php
<span class="text-kw">&lt;?php
</span><span class="text-var">$autoloader</span> = <span class="text-kw">include</span> <span class="text-kw">__DIR__</span> . <span class="text-str">&#039;/vendor/autoload.php&#039;</span>;

<span class="text-var">$app</span> = <span class="text-kw">new</span> <span class="text-type">Pop\Application</span>(<span class="text-var">$autoloader</span>, <span class="text-kw">include</span> <span class="text-kw">__DIR__</span> . <span class="text-str">&#039;/app/config/app.cli.php&#039;</span>);

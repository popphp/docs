            <span class="text-str">&#039;action&#039;</span>     =&gt; <span class="text-str">&#039;help&#039;</span>,
            <span class="text-str">&#039;help&#039;</span>       =&gt; <span class="text-str">&#039;Show the help screen&#039;</span>

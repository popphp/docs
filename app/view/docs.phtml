<?php
/**
 * Scaffolding, not the design.
 *
 * This exists so the generated routes, the page index and the prev/next chain can be exercised
 * end to end before a layout is drawn. It uses brand tokens only — no invented styling — so
 * whatever the design produces replaces this file outright rather than being untangled from it.
 */
$attr = fn(?string $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?><!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?=$attr($title) ?> — Pop PHP Framework</title>
    <link rel="shortcut icon" type="image/png" href="https://media.popphp.org/img/pop-php-icon.png">

    <!-- The brand's --font-display/--font-sans/--font-mono name families that have to be
         loaded, or every surface falls back to the system stack. Same three the v7 site loads. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">

    <link rel="stylesheet" href="/assets/css/app.css">

    <!-- Social sharing. The v7 marketing site points og:image at a screenshot of its own
         homepage, which is wrong for a docs page — the card should carry the page's title.
         Left unset until the docs site has a look to render a card from. -->
    <meta name="description" content="<?=$attr($description) ?>">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="Pop PHP Framework">
    <meta property="og:title" content="<?=$attr($title) ?>">
    <meta property="og:description" content="<?=$attr($description) ?>">
    <meta name="twitter:card" content="summary_large_image">
</head>
<body class="bg-bg text-fg font-sans">
    <div class="mx-auto flex max-w-7xl gap-10 px-6 py-10">

        <nav class="hidden w-64 shrink-0 lg:block">
            <a href="/" class="mb-8 block" aria-label="Pop PHP home">
                <!-- Same file in both themes: the approved v7 site does not swap the logo for dark. -->
                <img src="https://media.popphp.org/img/pop-php-logo2.png" alt="Pop PHP" class="block h-[46px] w-auto">
            </a>
<?php foreach ($nav as $section => $pages): ?>
            <div class="mb-6">
                <div class="eyebrow mb-2 text-[11px]"><?=$section ?></div>
                <ul class="space-y-1">
<?php foreach ($pages as $page): ?>
                    <li>
                        <a href="<?=$page['slug'] ?>" class="side-link<?=$page['current'] ? ' side-link-active' : '' ?>"><?=$page['title'] ?></a>
                    </li>
<?php endforeach; ?>
                </ul>
            </div>
<?php endforeach; ?>
        </nav>

        <main class="min-w-0 flex-1">
            <div class="eyebrow text-[11px]"><?=$section ?></div>
            <h1 class="mb-6 font-display text-section"><?=$title ?></h1>

<?php if (!empty($components)): ?>
            <div class="mb-6 flex flex-wrap gap-2">
<?php foreach ($components as $component): ?>
                <span class="tag"><?=$component ?></span>
<?php endforeach; ?>
            </div>
<?php endif; ?>

<?php if ($content !== null): ?>
            <div class="prose">
<?php include $content; ?>
            </div>
<?php else: ?>
            <div class="card">
                <p class="text-muted">Content for <code class="font-mono text-pop-orange"><?=$attr($slug) ?></code>
                   has not been generated yet. Run <code class="font-mono">php tools/build-views.php</code>
                   in the new-docs folder.</p>
            </div>
<?php endif; ?>

            <div class="mt-12 flex justify-between border-t border-line pt-6 text-sm">
                <span><?php if ($prev !== null): ?><a href="<?=$prev['slug'] ?>">← <?=$prev['title'] ?></a><?php endif; ?></span>
                <span><?php if ($next !== null): ?><a href="<?=$next['slug'] ?>"><?=$next['title'] ?> →</a><?php endif; ?></span>
            </div>
        </main>

<?php if (!empty($headings)): ?>
        <aside class="hidden w-52 shrink-0 xl:block" x-data="reading">
            <div class="eyebrow mb-3 text-[10.5px]">On this page</div>
            <nav class="flex flex-col">
<?php foreach ($headings as $heading): ?>
                <a href="#<?=$attr($heading['id']) ?>" class="rail-link<?=($heading['level'] === 3) ? ' rail-link-sub' : '' ?>"><?=$attr($heading['text']) ?></a>
<?php endforeach; ?>
            </nav>
        </aside>
<?php endif; ?>
    </div>
    <script type="module" src="/assets/js/app.js"></script>
</body>
</html>

<?php
/**
 * The documentation page shell.
 *
 * Built from the approved design canvas: three columns on a wide screen, the section nav
 * collapsing to a drawer below it, and the on-this-page rail appearing only where there is room
 * for it. Every page gets the same shell, / included — a front door you cannot navigate from is
 * the one place the nav matters most.
 *
 * Expects: $title $description $section $components $slug $nav $headings $prev $next $content
 */
$attr = fn(?string $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
?><!doctype html>
<html lang="en" class="no-js">
<head>
<?php include __DIR__ . '/partials/head.phtml'; ?>
</head>
<body class="bg-bg font-sans text-fg antialiased" x-data>

<?php include __DIR__ . '/partials/header.phtml'; ?>

<div class="mx-auto flex w-full max-w-[1440px] items-start gap-8 px-5 pb-20 pt-8 lg:gap-10 lg:px-8">

    <!-- One nav, not two: a sticky column from lg up, the same element sliding in as a drawer
         below it. Rendering it twice would ship 61 extra links on every page. -->
    <div x-cloak x-show="$store.docs.nav" class="fixed inset-0 z-30 bg-[rgba(23,21,15,.42)] lg:hidden"
         @click="$store.docs.closeNav()"></div>

    <aside id="docs-nav" aria-label="Documentation sections"
           class="fixed inset-y-0 left-0 z-40 w-[300px] max-w-[85vw] overflow-y-auto border-r border-line bg-panel px-3 pt-[78px] transition-transform duration-200
                  lg:sticky lg:top-[78px] lg:z-auto lg:max-h-[calc(100vh-98px)] lg:w-60 lg:shrink-0 lg:translate-x-0 lg:border-0 lg:bg-transparent lg:px-0 lg:pt-0"
           :class="$store.docs.nav ? 'translate-x-0' : '-translate-x-full'">
<?php include __DIR__ . '/partials/nav.phtml'; ?>
    </aside>

    <main class="min-w-0 max-w-[46rem] grow">
        <div class="eyebrow mb-2.5 text-[11px]"><?=$attr($section) ?></div>
        <h1 class="mb-3.5 font-display text-[clamp(2rem,4vw,2.75rem)] leading-[1.06] tracking-[-0.03em]"><?=$attr($title) ?></h1>

<?php if (!empty($components)): ?>
        <div class="mb-7 flex flex-wrap gap-2">
<?php foreach ($components as $component): ?>
            <a href="https://github.com/popphp/<?=$attr($component) ?>" class="tag" target="_blank" rel="noopener noreferrer"><?=$attr($component) ?></a>
<?php endforeach; ?>
        </div>
<?php endif; ?>

<?php if ($content !== null): ?>
        <div class="prose">
<?php include $content; ?>
        </div>
<?php else: ?>
        <div class="card">
            <p class="text-muted">Content for <code class="font-mono text-pop-orange"><?=$attr($slug) ?></code>
               has not been generated yet. Run <code class="font-mono">php tools/build-views.php</code>
               in the new-docs folder.</p>
        </div>
<?php endif; ?>

<?php if ($prev !== null || $next !== null): ?>
        <nav class="mt-14 flex flex-col gap-3 sm:flex-row" aria-label="Page navigation">
<?php if ($prev !== null): ?>
            <a href="<?=$attr($prev['slug']) ?>" class="page-turn">
                <span class="page-turn-label">Previous</span>
                <span class="flex items-center gap-2 font-semibold">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"></path><path d="m11 6-6 6 6 6"></path></svg>
                    <?=$attr($prev['title']) ?>
                </span>
            </a>
<?php endif; ?>
<?php if ($next !== null): ?>
            <a href="<?=$attr($next['slug']) ?>" class="page-turn sm:text-right">
                <span class="page-turn-label">Next</span>
                <span class="flex items-center gap-2 font-semibold sm:justify-end">
                    <?=$attr($next['title']) ?>
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
                </span>
            </a>
<?php endif; ?>
        </nav>
<?php endif; ?>
    </main>

<?php if (!empty($headings)): ?>
    <aside class="sticky top-[78px] hidden max-h-[calc(100vh-98px)] w-52 shrink-0 overflow-y-auto xl:block" x-data="reading">
        <div class="eyebrow mb-3 text-[10.5px]">On this page</div>
        <nav class="flex flex-col" aria-label="On this page">
<?php foreach ($headings as $heading): ?>
            <a href="#<?=$attr($heading['id']) ?>" class="rail-link<?=($heading['level'] === 3) ? ' rail-link-sub' : '' ?>"><?=$attr($heading['text']) ?></a>
<?php endforeach; ?>
        </nav>
    </aside>
<?php endif; ?>

</div>

<?php include __DIR__ . '/partials/search.phtml'; ?>

</body>
</html>

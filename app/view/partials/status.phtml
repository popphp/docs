<?php
/**
 * The shared page for 404, 500 and 503 — the three views that are not documentation.
 *
 * They share the site's header and type so a reader who hits one is plainly still on the docs
 * site, rather than dropped onto an unstyled page from a different decade.
 *
 * Expects: $title $code $heading $body   Optional: $detail $showSearch $actions
 */
$attr          = fn(?string $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$hasNav        = false;
$internalLinks = $internalLinks ?? true;
$showSearch = $showSearch ?? false;
$hasSearch  = $showSearch;
$detail     = $detail ?? null;
$actions    = $actions ?? [];
?><!doctype html>
<html lang="en" class="no-js">
<head>
<?php include __DIR__ . '/head.phtml'; ?>
</head>
<body class="bg-bg font-sans text-fg antialiased" x-data>

<?php include __DIR__ . '/header.phtml'; ?>

<main class="mx-auto flex w-full max-w-[46rem] flex-col items-start px-5 py-20 lg:px-8 lg:py-28">

    <div class="eyebrow mb-4 text-[11px]"><?=$attr((string)$code) ?></div>

    <h1 class="mb-4 font-display text-[clamp(2rem,5vw,3rem)] leading-[1.04] tracking-[-0.03em]"><?=$attr($heading) ?></h1>

    <p class="mb-8 max-w-[52ch] text-[17px]/[1.7] text-muted"><?=$body ?></p>

<?php if ($detail !== null): ?>
    <div class="code-window mb-8 w-full">
        <div class="code-window-bar"><span class="code-lang">DETAIL</span></div>
<pre><code><span class="text-comment"><?=$attr($detail) ?></span></code></pre>
    </div>
<?php endif; ?>

<?php if ($showSearch): ?>
    <button type="button" @click="$store.docs.openSearch()"
            class="mb-8 flex w-full max-w-[400px] items-center gap-2.5 rounded-full border border-line bg-panel px-4 py-2.5 text-[15px] text-muted transition-colors duration-150 hover:border-pop-orange/40">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <span class="grow text-left">Search the documentation</span>
        <span class="key">⌘K</span>
    </button>
<?php endif; ?>

<?php if ($actions !== []): ?>
    <nav class="flex flex-wrap gap-3" aria-label="Where to go next">
<?php foreach ($actions as $action): ?>
        <a href="<?=$attr($action['href']) ?>" class="page-turn !flex-none px-5"><?=$attr($action['label']) ?></a>
<?php endforeach; ?>
    </nav>
<?php endif; ?>

</main>

<?php if ($showSearch): ?>
<?php include __DIR__ . '/search.phtml'; ?>
<?php endif; ?>

</body>
</html>

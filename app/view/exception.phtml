<?php
/**
 * Rendered by App\Application::httpError() when something threw before or during dispatch.
 *
 * It cannot assume the application finished loading — the throw may be what stopped it — so this
 * page reads nothing from config and carries no navigation beyond the header.
 *
 * The exception message is shown only outside production. In production it is the sort of thing
 * that leaks a path or a credential to whoever tripped it, and it is already in the log.
 *
 * Expects: $title $message   Optional: $code
 */
$code    = $code ?? 500;
$heading = 'Something went wrong';
$body    = 'The documentation site hit an error handling that request. It has been logged. '
         . 'Trying again in a moment is worth a shot.';

$env    = $_ENV['APP_ENV'] ?? getenv('APP_ENV') ?: 'production';
$detail = (strtolower((string)$env) === 'production') ? null : ($message ?? null);

$actions = [
    ['href' => '/',           'label' => 'Overview'],
    ['href' => '/components', 'label' => 'All Components'],
];

include __DIR__ . '/partials/status.phtml';
